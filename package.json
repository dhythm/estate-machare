{
  "name": "estate-machare",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "dev:mock": "DATA_STORE=memory next dev",
    "dev:agent": "DATA_STORE=pglite next dev",
    "db:migrate": "node --import tsx --conditions=react-server scripts/db.ts migrate",
    "db:reset": "node --import tsx --conditions=react-server scripts/db.ts reset",
    "db:sql": "node --import tsx --conditions=react-server scripts/db.ts sql",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "next typegen && tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:pglite": "DATA_STORE=pglite PGLITE_DATA_DIR=memory:// vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm knip && pnpm test:coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/react-query": "^5.102.8",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "postcss": "^8.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.7.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.3.4"
  }
}
